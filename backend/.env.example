# ======================================================================
# HerGuardian — backend environment variables
#
# LOCAL:       copy this file to ".env" and fill it in.
# PRODUCTION:  do NOT upload a .env file. Add each variable in your
#              host's dashboard (Render → Environment). See DEPLOYMENT.md.
# NEVER commit .env to Git. (.gitignore already excludes it.)
# ======================================================================

# ── Server ───────────────────────────────────────────────────────────
# set to "production" on the host
NODE_ENV=development
# Render/Railway set this automatically — don't set it there
PORT=5000

# Your frontend URL(s), no trailing slash. Used for CORS and for the link in
# verification emails. Several allowed? Separate with commas.
#   local:       http://localhost:5173
#   production:  https://herguardian.vercel.app
CLIENT_URL=http://localhost:5173

# ── MongoDB Atlas (required) ─────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the string.
# Replace <password> with your DB user's password (URL-encode special characters)
# and add the database name before the "?"  →  .../herguardian?retryWrites=...
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/herguardian?retryWrites=true&w=majority

# ── JWT (required) ───────────────────────────────────────────────────
# Generate a strong secret (run in terminal):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server REFUSES to start in production if this is short or a placeholder.
JWT_SECRET=
JWT_EXPIRE=7d

# ── Email (needed for verification emails + SOS emails) ──────────────
# Choose ONE provider.
#
# Option A (RECOMMENDED for Render/Railway/any cloud) — Brevo HTTPS API, free 300 emails/day
#   1. Sign up at https://www.brevo.com
#   2. Settings → Senders, Domains & Dedicated IPs → Senders → add + VERIFY your email
#   3. SMTP & API → API Keys → Generate a key (starts with "xkeysib-")
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# the sender address you verified in Brevo
EMAIL_FROM=
EMAIL_FROM_NAME=HerGuardian
#
# Option B — Gmail SMTP (fine locally / on a VPS; ⚠ BLOCKED on Render FREE tier)
#   Needs 2-Step Verification on, then an App Password: myaccount.google.com/apppasswords
# EMAIL_PROVIDER=smtp
# GMAIL_USER=yourname@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop     # 16 chars, no spaces

# ── Twilio — SMS alerts for SOS (optional; SOS falls back to email only) ──
# https://www.twilio.com/console  — Trial accounts can ONLY text numbers you have
# verified in the Twilio console. Indian numbers may need extra (DLT) registration
# for real use — see DEPLOYMENT.md "Before real users".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# your Twilio number in +E.164 format, e.g. +14155552671
TWILIO_PHONE_NUMBER=

# SOS safety valve (default true): only email-verified users can fire SOS.
# This stops throw-away accounts from using your Twilio credits to message strangers.
# SOS_REQUIRE_VERIFIED_EMAIL=true

# ── Anthropic Claude API — AI chat + Smart Health Insights (optional) ─
# https://console.anthropic.com  → API Keys. (Requires billing credit.)
ANTHROPIC_API_KEY=
# Model ID. Default "claude-sonnet-5-5". Cheaper/faster option: claude-haiku-5-5
# (Do NOT use claude-sonnet-4-20250514 — it was retired on 15 June 2026.)
# ANTHROPIC_MODEL=claude-sonnet-5-5
